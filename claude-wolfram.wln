(* drag the four entries and watch what the matrix DOES to the unit square *)
(* red = where (1,0) lands, green = where (0,1) lands — they are A's columns *)
(* det = the area scale factor; negative det means the square got flipped over *)
Manipulate[
  Graphics[{
    Lighter[Gray, 0.6], EdgeForm[Gray], Polygon[{{0, 0}, {1, 0}, {1, 1}, {0, 1}}],
    Opacity[0.45], Blue, EdgeForm[{Thick, Darker[Blue]}],
    Polygon[({{m11, m12}, {m21, m22}} . # &) /@ {{0, 0}, {1, 0}, {1, 1}, {0, 1}}],
    Opacity[1], Red, Thick, Arrow[{{0, 0}, {{m11, m12}, {m21, m22}} . {1, 0}}],
    Darker[Green], Thick, Arrow[{{0, 0}, {{m11, m12}, {m21, m22}} . {0, 1}}]},
   PlotRange -> {{-3, 3}, {-3, 3}}, Axes -> True, ImageSize -> 420,
   PlotLabel -> Row[{"det = ", fmt[Det[{{m11, m12}, {m21, m22}}], 2],
                     "    (area scale factor)"}]],
  {{m11, 1, "a"}, -2, 2, 0.05}, {{m12, 0, "b"}, -2, 2, 0.05},
  {{m21, 0, "c"}, -2, 2, 0.05}, {{m22, 1, "d"}, -2, 2, 0.05},
  ContinuousAction -> True
]

