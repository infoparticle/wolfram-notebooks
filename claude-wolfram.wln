(* generate the LaTeX straight from the expression, so it can never drift from the code *)
TeXForm /@ <|
  "P(r) sum form"   -> HoldForm[Sum[C/(1 + r)^t, {t, 1, n}] + F/(1 + r)^n],
  "P(r) closed"     -> HoldForm[C (1 - (1 + r)^-n)/r + F (1 + r)^-n],
  "our bond closed" -> Simplify[Sum[5/(1 + r)^t, {t, 1, 5}] + 100/(1 + r)^5],
  "dP/dr"           -> Simplify[D[Sum[5/(1 + r)^t, {t, 1, 5}] + 100/(1 + r)^5, r]]
|>

