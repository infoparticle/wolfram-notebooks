(* 5-year annual bond, face 100, 5% coupon, priced off yield r *)
price[r_] := Sum[5/(1 + r)^t, {t, 1, 5}] + 100/(1 + r)^5;

{
  "price at r = 4%"        -> price[0.04],
  "dP/dr (dollar duration)" -> price'[0.04],
  "P&L for a +1bp move"     -> price'[0.04]*0.0001
} // pp

