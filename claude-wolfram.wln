(* how good is each approximation? shock the yield away from 4% *)
base = 0.04;
TableForm[
  Table[
    With[{shocked = base + h,
          dur = price[base] + price'[base] h,
          both = price[base] + price'[base] h + 0.5 price''[base] h^2},
      {h*10000, price[base + h], dur, price[base + h] - dur, both, price[base + h] - both}],
    {h, {-0.02, -0.01, -0.0025, 0.0025, 0.01, 0.02}}] // fmt[#, 4] &,
  TableHeadings -> {None,
    {"shock (bp)", "true P", "duration only", "error", "dur+convexity", "error"}}
]

