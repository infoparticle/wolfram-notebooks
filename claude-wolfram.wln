(* symbolic where possible, numeric where not *)
{
  "Gaussian over the whole line (exact!)" -> Integrate[Exp[-x^2], {x, -Infinity, Infinity}],
  "but on a finite interval"              -> Integrate[Exp[-x^2], {x, 0, 1}],
  "...as a number"                        -> NIntegrate[Exp[-x^2], {x, 0, 1}] // fmt[#, 6] &,
  "no elementary form at all"             -> NIntegrate[Exp[-x^2] Cos[x], {x, -3, 3}] // fmt[#, 6] &
}

